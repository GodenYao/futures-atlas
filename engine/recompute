#!/usr/bin/env node
'use strict';
// Futures Atlas `recompute` — replays every REVIEWED ledger phase (backfill/<phase>/ with review/approved_<phase>.json)
// plus accepted items in reviewed/<year>/ into weekly reconstructed snapshots. No hard-coded year: see "Week range" below.
// Usage: node engine/recompute [--check] [--draws N] [--no-mc] [--from YYYY-Www] [--to YYYY-Www] [--today YYYY-MM-DD]
//   default : writes engine/snapshots/atlas-<year>-Www.json (first..last week) + engine/replay_summary.json
//   --check : §3.9 worked-example unit check (stdout only, writes nothing)
//   --export-ui [--out FILE] : compact per-week arrays for the map (default engine/out/g1_replay_data.js)
const fs = require('fs');
const path = require('path');
const E = require('./lib.js');
const { ROADS, NONE } = E;

const SITE = path.resolve(__dirname, '..');
const args = process.argv.slice(2);
const arg = (k, d) => { const i = args.indexOf(k); return i >= 0 ? args[i + 1] : d; };
const r4 = x => Math.round(x * 1e4) / 1e4;
const pp = x => Math.round(x * 1000) / 10;

if (args.includes('--check')) { runCheck(); process.exit(0); }
if (args.includes('--export-ui')) { exportUI(); process.exit(0); }

// ---------------- --export-ui: compact per-week arrays for the G1 preview (reads the written snapshots; recomputes nothing) ----------------
//   node engine/recompute --export-ui [--out FILE]   (default FILE = site/g1_preview/src/g1_replay_data.js)
function exportUI() {
  const SN = path.join(__dirname, 'snapshots');
  const files = fs.readdirSync(SN).filter(f => /^atlas-\d{4}-W\d\d\.json$/.test(f)).sort();
  const yrs = [...new Set(files.map(f => f.slice(6, 10)))].join(',');
  const RK = ROADS.concat([NONE]), LK = ['pooled'].concat(Object.keys(E.LENSES)), SK = E.SITES.slice();
  const out = { method_version: null, label: null, roads: RK, sites: SK, lenses: LK, weeks: [], as_of: [], lens: {}, items: [], prior_sites: {} };
  // site shares under each lens PRIOR (no evidence) = the NOW home position for the Q20 centroid (same E.sitesOf + central splits as the snapshots)
  const POOLP = {}; for (const T of RK) POOLP[T] = Object.values(E.LENSES).reduce((a, L) => a + L.prior[T], 0) / 4;
  for (const L of LK) { const st = E.sitesOf(L === 'pooled' ? POOLP : E.LENSES[L].prior, E.centralSplits()); out.prior_sites[L] = SK.map(s => r4(st[s])); }
  for (const L of LK) out.lens[L] = { w: [], lo: [], hi: [], s: [] };
  for (const f of files) {
    const j = JSON.parse(fs.readFileSync(path.join(SN, f), 'utf8'));
    out.method_version = j.method_version; out.label = j.label; out.weeks.push(j.week); out.as_of.push(j.as_of);
    for (const L of LK) {
      const x = j.lenses[L], o = out.lens[L];
      o.w.push(RK.map(T => x.roads[T].central)); o.lo.push(RK.map(T => x.roads[T].p10)); o.hi.push(RK.map(T => x.roads[T].p90));
      o.s.push(SK.map(s => x.sites[s].central));
    }
    out.items.push((j.weekly_diff.items_entering || []).map(it => [it.id, it.indicator, it.direction, it.published]));
  }
  const file = arg('--out', path.join(__dirname, 'out', 'g1_replay_data.js')); fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, `// GENERATED by \`node engine/recompute --export-ui\` from engine/snapshots/atlas-${yrs.includes(',') ? '{' + yrs + '}' : yrs}-W*.json (${files.length} weeks, method ${out.method_version}). Do not edit.\n` +
    `// lens.<id>.w/lo/hi[week][road] = central/p10/p90 road share (0-1, roads order); lens.<id>.s[week][site] = central site share; items[week] = [id, indicator, direction, published] entering that week.\n` +
    'var BFRP=' + JSON.stringify(out).replace(/</g, '\\u003c') + ';\n');
  console.log(`export-ui: ${files.length} weeks (${out.weeks[0]}..${out.weeks[out.weeks.length - 1]}), ${LK.length} lenses -> ${file} (${fs.statSync(file).size} bytes)`);
}

// ---------------- §3.9 unit check ----------------
function runCheck() {
  const P = E.defaultParams(); const prior = E.LENSES.baseline.prior;
  const provs = {
    'I-R1-01': E.provFixedState(0.80, 0.95),
    'I-R1-04': (pbar) => ({ r: E.sigm(E.logit(pbar) + (-0.30) * Math.pow(2, -49 / 180)), rho: 0.98, fcFrac: 0 }),
    'I-R5-02': E.provResolution(1),
    'I-R2-01': E.provFixedState(0.70, 0.95),
    'I-R2-05': E.provFixedState(0.55, 0.95),
    'I-R4-02': (pbar) => ({ r: E.sigm(E.logit(pbar) + Math.min(0.5, E.logit(0.70) - E.logit(pbar))), rho: 1, fcFrac: 1 }),
  };
  const exp = {
    'I-R1-01': { pbar: .671, r: .80, rt: .794, l: [.095, .016, -.040, .016, -.230, -.070] },
    'I-R1-04': { pbar: .822, r: .782, rt: .783, l: [-.034, -.007, .105, -.034, -.007, -.007] },
    'I-R5-02': { pbar: .478, r: 1, rt: 1, l: [-.312, .044, -.179, .227, .575, -.061] },
    'I-R2-01': { pbar: .471, r: .70, rt: .689, l: [-.018, .219, -.111, .025, -.018, -.270] },
    'I-R2-05': { pbar: .430, r: .55, rt: .544, l: [-.014, .097, -.038, .009, -.014, -.087] },
    'I-R4-02': { pbar: .458, r: .582, rt: .582, l: [-.004, .045, -.004, .136, -.004, -.197] },
  };
  const expTot = [-.28, .31, -.22, .37, .31, -.57];
  const expComb = { R1: 22.8, R2: 27.3, R3: 12.1, R4: 14.5, R5: 13.7, R6: 6.8, None: 3.0 };
  const expEv = { R1: 12, R2: 21, R3: 12, R4: 22, R5: 21, R6: 9, None: 3 };
  const expB5 = { R1: 26, R2: 24, R3: 14, R4: 12, R5: 12, R6: 9, None: 3 };
  const expLoo = { 'I-R5-02': [-8.0, 1.5, -2.2, 3.1, 6.1, -0.4], 'I-R1-01': [2.4, .9, -.3, .5, -3.2, -.4], 'I-R2-01': [-.6, 3.4, -1.1, .1, -.3, -1.4], 'I-R4-02': [-.4, .8, -.2, 1.7, -.2, -1.6], 'I-R2-05': [-.4, 1.5, -.4, 0, -.2, -.5], 'I-R1-04': [-.7, -.1, 1.3, -.4, 0, 0] };
  const expSites = { enslaved: 16, normaltech: 14, descendants: 9, zookeeper: 8, libertarian: 7, benevolent: 7, conquerors: 7, protector: 6, gatekeeper: 6, egalitarian: 6, selfdestruct: 5, o1984: 4, reversion: 2 };
  let fails = 0, n = 0; const rows = [];
  const chk = (name, got, want, tol) => { n++; const ok = Math.abs(got - want) <= tol + 1e-9; if (!ok) fails++; rows.push(`${ok ? 'PASS' : 'FAIL'}  ${name.padEnd(34)} got ${(+got.toFixed(4)).toString().padStart(8)}  want ${want}  tol ${tol}`); };
  const res = E.evalRoads(prior, provs, P);
  for (const id in exp) {
    const x = res.per[id], e = exp[id];
    chk(id + ' pbar', x.pbar, e.pbar, 0.0015); chk(id + ' r', x.r, e.r, 0.0015); chk(id + ' r~', x.rt, e.rt, 0.0015);
    e.l.forEach((v, j) => chk(`${id} l(${ROADS[j]}) pre-family`, x.lraw[j], v, 0.0015));
  }
  chk('labour-entry family m', res.per['I-R2-01'].m, 0.667, 0.0005);
  chk('forecast family scale (no clip)', res.fcScale, 1, 0);
  res.total.forEach((v, j) => chk(`total evidence ${ROADS[j]}`, v, expTot[j], 0.006));
  for (const T in expComb) chk(`combined ${T} (pp)`, res.w[T] * 100, expComb[T], 0.15);
  // Evidence-only: the §3.9 table matches "lens ℓ, flat prior in the softmax" (graded); the §3.7 text ("p̄ under the flat prior") is reported as info.
  const ev = E.evalRoads(prior, provs, P, { flatSoftmaxOnly: true });
  for (const T in expEv) chk(`evidence-only ${T} (pp, integer)`, ev.w[T] * 100, expEv[T], 0.55);
  const evB = E.evalRoads(prior, provs, P, { flat: true });
  rows.push('INFO  evidence-only, §3.7 text variant (p̄ recomputed under flat prior): ' + Object.keys(expEv).map(T => `${T} ${pp(evB.w[T])}`).join(' · '));
  const b5 = E.evalRoads(prior, provs, P, { beta: 0.5 });
  for (const T in expB5) chk(`beta=0.5 ${T} (pp, integer)`, b5.w[T] * 100, expB5[T], 0.55);
  for (const id in expLoo) {
    const p2 = Object.assign({}, provs); delete p2[id]; const r2 = E.evalRoads(prior, p2, P, { famN: res.famN });
    expLoo[id].forEach((v, j) => chk(`LOO ${id} ${ROADS[j]} (pp)`, (res.w[ROADS[j]] - r2.w[ROADS[j]]) * 100, v, 0.15));
  }
  const st = E.sitesOf(res.w, E.centralSplits());
  for (const s in expSites) chk(`site ${s} central (pp, integer)`, st[s] * 100, expSites[s], 0.55);
  const lane = { 'I-TF-01': E.provFixedState(0.55, 0.95), 'I-TF-02': E.provFixedState(0.50, 0.95) };
  const q = E.evalLane(lane, P); chk('R1 lane q', q, 0.54, 0.005); chk('narrow masters share (pp)', q * res.w.R1 * 100, 12, 0.55);
  chk('implied P(I-R5-02 YES) under prior', res.per['I-R5-02'].pbar, 0.48, 0.005);
  // Monte Carlo (informative; reference sketch RNG unknown) — 4000 draws, seed 46, live sigma 0.25
  const rng = E.mulberry32(46); const D = 4000; const W = {}; for (const T of ROADS.concat([NONE])) W[T] = new Float64Array(D);
  for (let d = 0; d < D; d++) { const k = 0.5 + rng(); const rhoF = 0.3 + 0.4 * rng(); E.drawSplits(rng); const pr = E.perturbPrior(prior, rng, 0.25); const r = E.evalRoads(pr, provs, P, { k, rhoF }); for (const T in r.w) W[T][d] = r.w[T]; }
  const expI = { R1: [16, 30], R2: [20, 34], R3: [9, 16], R4: [10, 20], R5: [10, 18], R6: [4, 10], None: [2, 4] };
  const mcRows = [];
  for (const T in expI) mcRows.push(`MC   ${T.padEnd(4)} 80% got ${pp(E.quantile(W[T], .1))}-${pp(E.quantile(W[T], .9))}  doc ${expI[T][0]}-${expI[T][1]} (informative, not graded)`);
  console.log(rows.join('\n')); console.log(mcRows.join('\n'));
  console.log(`\n§3.9 CHECK: ${n - fails}/${n} passed${fails ? ' — ' + fails + ' FAILED' : ''}`);
  console.log('combined (pp): ' + Object.keys(expComb).map(T => `${T} ${pp(res.w[T])}`).join(' · '));
}

// ---------------- replay ----------------
const P = E.defaultParams();
if (arg('--draws')) P.mc.draws = +arg('--draws');
const noMC = args.includes('--no-mc');
const ledger = E.loadLedger(SITE);
const OUT = path.join(__dirname, 'snapshots'); fs.mkdirSync(OUT, { recursive: true });
// Week range (year-agnostic, no hard-coded year):
//   first week = --from YYYY-Www, else the start of the OLDEST counted phase (phase "2026" -> 2026-W01,
//                phase "2022-11" -> the ISO week of 2022-11-01);
//   last week  = --to YYYY-Www, else the last COMPLETE ISO week before today (--today YYYY-MM-DD or env
//                FA_TODAY; default = system date, UTC). Run on Monday 01:00 UTC -> the week that just ended.
const wkMon = s => { const m = /^(\d{4})-W(\d\d)$/.exec(s || ''); if (!m) throw new Error('bad week ' + s + ' (want YYYY-Www)'); return E.isoWeekMonday(+m[1], +m[2]); };
const phaseMon = ph => { const m = /^(\d{4})(?:-(\d\d))?/.exec(ph); if (!m) throw new Error('phase folder name must start with YYYY: ' + ph); if (!m[2]) return E.isoWeekMonday(+m[1], 1); const n = E.dnum(`${m[1]}-${m[2]}-01`); return n - ((new Date(n * 864e5).getUTCDay() + 6) % 7); };
if (!ledger.phases.length && !ledger.nReviewed) { console.error('recompute: no reviewed phase (backfill/review/approved_<phase>.json) and no reviewed/ items - nothing to replay'); process.exit(1); }
const firstMon = arg('--from') ? wkMon(arg('--from')) : Math.min(...ledger.phases.map(phaseMon));
const todayN = E.dnum(arg('--today', process.env.FA_TODAY || new Date().toISOString().slice(0, 10)));
const lastMon = arg('--to') ? wkMon(arg('--to')) : todayN - ((new Date(todayN * 864e5).getUTCDay() + 6) % 7) - 7;
const WEEKS = []; for (let m = firstMon; m <= lastMon; m += 7) { const [y, w] = E.isoWeekOf(m); WEEKS.push({ y, w, mon: m }); }
if (!WEEKS.length) { console.error('recompute: empty week range'); process.exit(1); }
console.error(`recompute: phases counted [${ledger.phases.join(', ')}], not counted (unreviewed) [${ledger.skipped.join(', ')}], reviewed/ items ${ledger.nReviewed}; weeks ${WEEKS[0].y}-W${String(WEEKS[0].w).padStart(2, '0')}..${WEEKS[WEEKS.length - 1].y}-W${String(WEEKS[WEEKS.length - 1].w).padStart(2, '0')}`);
const POOL_PRIOR = {}; for (const T of ROADS.concat([NONE])) POOL_PRIOR[T] = Object.values(E.LENSES).reduce((a, L) => a + L.prior[T], 0) / 4;
const allItems = Object.entries(ledger.byInd).flatMap(([id, its]) => its.map(it => Object.assign({ indicator_key: id }, it)));

let prev = null; const series = []; const lensKeys = Object.keys(E.LENSES); const written = new Set();
for (let wi = 0; wi < WEEKS.length; wi++) {
  const { y, w, mon } = WEEKS[wi]; // MC seed = ISO week number (stable when older history is prepended)
  const wk = `${y}-W${String(w).padStart(2, '0')}`;
  const asOf = E.dstr(mon + 7); // Monday 00:00 UTC freeze after week w
  const C = E.centralWeek(ledger, asOf, P);
  const M = noMC ? null : E.mcWeek(ledger, asOf, P, w);
  const lenses = {};
  for (const L of lensKeys.concat(['pooled'])) {
    const src = L === 'pooled' ? C.pooled : C.lenses[L]; const prior = L === 'pooled' ? POOL_PRIOR : E.LENSES[L].prior;
    const roads = {};
    for (const T of ROADS.concat([NONE])) roads[T] = { prior: prior[T], central: r4(src.w[T]), p10: M ? r4(M[L].roads[T][0]) : null, p90: M ? r4(M[L].roads[T][1]) : null,
      delta: { evidence: prev ? r4(src.w[T] - prev[L][T]) : null, method: 0, horizon_roll: 0 } };
    const sites = {}; for (const s of E.SITES) sites[s] = { central: r4(src.sites[s]), p10: M ? r4(M[L].sites[s][0]) : null, p90: M ? r4(M[L].sites[s][1]) : null };
    lenses[L] = { name: L === 'pooled' ? 'Pooled (equal-weight mean of 4 seed lenses)' : E.LENSES[L].name, roads, sites };
  }
  // per-indicator block
  const indicators = {};
  for (const id of Object.keys(E.IND)) {
    const by = {}; let rSum = 0, rtSum = 0; const lSum = ROADS.map(() => 0);
    for (const L of lensKeys) { const x = C.lenses[L].per[id]; by[L] = { pbar: r4(x.pbar), r: r4(x.r), r_tilde: r4(x.rt), rho: r4(x.rho), family_m: r4(x.m), l: Object.fromEntries(ROADS.map((T, j) => [T, r4(x.l[j])])) }; rSum += x.r; rtSum += x.rt; x.l.forEach((v, j) => lSum[j] += v); }
    const x0 = C.lenses.baseline.per[id];
    indicators[id] = { family: E.IND[id].fam, row_from: E.IND[id].rowFrom || id, active: x0.active, low_diagnosticity: x0.low, inputs: C.used[id], parts_baseline: x0.parts,
      resolved: ledger.resolutions[id] && E.dnum(ledger.resolutions[id].date) < E.dnum(asOf) ? ledger.resolutions[id] : null,
      by_lens: by, pooled_mean: { r: r4(rSum / 4), r_tilde: r4(rtSum / 4), l: Object.fromEntries(ROADS.map((T, j) => [T, r4(lSum[j] / 4)])) } };
  }
  const attrs = { q_narrow: r4(C.q), q_p10_p90: M ? M.q.map(r4) : null, narrow_masters_share_pooled: r4(C.q * C.pooled.w.R1), holders_N: Object.fromEntries(Object.entries(C.N).map(([k, v]) => [k, r4(v)])), lane_inputs: Object.fromEntries(Object.keys(E.LANE).map(id => [id, C.used[id]])), holder_inputs: { 'I-N-01': C.used['I-N-01'], 'I-N-02': C.used['I-N-02'] } };
  const weekStart = E.dstr(mon);
  const newItems = allItems.filter(it => (wi === 0 ? true : it.published >= weekStart) && it.published < asOf).map(it => ({ id: it.id, indicator: it.indicator_key, kind: it.kind, direction: it.direction, published: it.published }));
  const pooledDelta = prev ? Object.fromEntries(ROADS.concat([NONE]).map(T => [T, r4(C.pooled.w[T] - prev.pooled[T])])) : null;
  const snap = { week: wk, as_of: asOf, horizon_end: `${y + 10}-W${String(w).padStart(2, '0')}` /* rolling 10 years, same ISO week label as B.5 */,
    method_version: E.METHOD_VERSION, backfilled: true, label: 'Backfilled · reconstructed', ledger: { phase: ledger.phases.join('+'), approved: ledger.approved, as_of_rule: 'item counts iff published < as_of (Monday 00:00 UTC freeze); replay material (Q19a)', reviewed_items: ledger.nReviewed || undefined },
    mc: noMC ? null : { draws: P.mc.draws, seed: w, prior_sigma: P.mc.priorSigma, strength: P.mc.strength, rho_f: P.mc.rhoF },
    lenses, indicators, r1_attributes: attrs,
    weekly_diff: { pooled: pooledDelta, evidence_term: pooledDelta, method_term: 0, horizon_roll_term: 0, items_entering: newItems },
    excluded_items: wi === 0 ? ledger.excluded : undefined };
  fs.writeFileSync(path.join(OUT, `atlas-${wk}.json`), JSON.stringify(snap, null, 1)); written.add(`atlas-${wk}.json`);
  prev = {}; for (const L of lensKeys) prev[L] = C.lenses[L].w; prev.pooled = C.pooled.w;
  series.push({ week: wk, as_of: asOf, pooled: Object.fromEntries(ROADS.concat([NONE]).map(T => [T, r4(C.pooled.w[T])])), p10: M ? Object.fromEntries(ROADS.map(T => [T, r4(M.pooled.roads[T][0])])) : null, p90: M ? Object.fromEntries(ROADS.map(T => [T, r4(M.pooled.roads[T][1])])) : null, lenses: Object.fromEntries(lensKeys.map(L => [L, Object.fromEntries(ROADS.map(T => [T, r4(C.lenses[L].w[T])]))])), n_entering: newItems.length });
  process.stdout.write(`${wk} ${asOf} pooled ` + ROADS.map(T => `${T} ${pp(C.pooled.w[T])}`).join(' ') + `  (+${newItems.length} items)\n`);
}
// snapshots outside the current range (e.g. a phase moved back to unreviewed) would leak into --export-ui: drop them
for (const f of fs.readdirSync(OUT)) if (/^atlas-\d{4}-W\d\d\.json$/.test(f) && !written.has(f)) fs.unlinkSync(path.join(OUT, f));

// ---------------- last-week analysis: LOO + default sensitivity ----------------
const asOfLast = E.dstr(WEEKS[WEEKS.length - 1].mon + 7);
const base = E.centralWeek(ledger, asOfLast, P);
const lead = ROADS.reduce((a, T) => base.pooled.w[T] > base.pooled.w[a] ? T : a, 'R1');
const loo = [];
for (const id of Object.keys(E.IND).concat(Object.keys(E.LANE), ['I-N-02'])) {
  if (loo.find(x => x.id === id)) continue;
  const r = E.centralWeek(ledger, asOfLast, P, new Set([id]), Object.fromEntries(Object.keys(E.LENSES).map(L => [L, base.lenses[L].famN])));
  const eff = Object.fromEntries(ROADS.map(T => [T, Math.round((base.pooled.w[T] - r.pooled.w[T]) * 1e4) / 100]));
  loo.push({ id, effect_pp: eff, max_abs_pp: Math.max(...ROADS.map(T => Math.abs(eff[T]))), q_effect: r4(base.q - r.q) });
}
loo.sort((a, b) => b.max_abs_pp - a.max_abs_pp);
const scaleObj = (o, f) => Object.fromEntries(Object.entries(o).map(([k, v]) => [k, v * f]));
const DEFS = [
  ['P1 event delta by kind (incident/announcement/report .40/.25/.15 x conf 1/.67/.33)', (Q, f) => { Q.eventDeltaByKind = scaleObj(Q.eventDeltaByKind, f); }],
  ['P2 instrument delta (.40/.25/.10)', (Q, f) => { Q.instrDelta = scaleObj(Q.instrDelta, f); }],
  ['P3 state offset for direction-only series (.50/.35/.20 probit; s_i=1)', (Q, f) => { Q.stateShift = scaleObj(Q.stateShift, f); }],
  ['P3b state spread s_i (offset / s_i)', (Q, f) => { Q.stateSpread = f; }],
  ['P4 forecast shift (.50/.35/.20, cap .5)', (Q, f) => { Q.fcShift = scaleObj(Q.fcShift, f); }],
  ['P5 event half-lives (mapping to 365/180/90 d)', (Q, f) => { Q.halfLifeScale = f; }],
  ['P6 BTOS spread (4 pp/yr)', (Q, f) => { Q.btos.sdPerYear = 4 * f; }],
];
const sens = [];
for (const [name, fn] of DEFS) {
  const row = { name };
  for (const [lab, f] of [['half', 0.5], ['double', 2]]) { const Q = E.defaultParams(); fn(Q, f); const r = E.centralWeek(ledger, asOfLast, Q); row[lab] = Object.fromEntries(ROADS.map(T => [T, Math.round((r.pooled.w[T] - base.pooled.w[T]) * 1e4) / 100])); }
  row.lead_half_pp = row.half[lead]; row.lead_double_pp = row.double[lead]; row.max_abs_pp = Math.max(...ROADS.flatMap(T => [Math.abs(row.half[T]), Math.abs(row.double[T])]));
  sens.push(row);
}
// chart geometry for the report (pooled road shares per week)
const Wd = 640, Ht = 260, x0 = 44, y0 = 16; const ymax = Math.ceil(Math.max(...series.flatMap(s => ROADS.map(T => s.pooled[T]))) * 20) / 20;
